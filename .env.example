APP_NAME="Shataj School & College"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Dhaka
APP_CURRENCY=BDT

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_SUPPORTED_LOCALES=en,bn

APP_MAINTENANCE_DRIVER=file

# --- Multi-tenancy -----------------------------------------------------------
# Branch hosts are <subdomain>.<TENANCY_BASE_DOMAIN>, e.g. branch1.localhost:8000
TENANCY_BASE_DOMAIN=localhost
# Comma separated hosts that serve the central website + Super Admin (no port)
TENANCY_CENTRAL_DOMAINS=localhost,127.0.0.1
# URL prefix of the central administration on the central domain
TENANCY_CENTRAL_PATH=super-admin
# Force scheme when building cross-host links (http|https). Empty = current request scheme.
TENANCY_URL_SCHEME=
# Port appended to generated branch URLs (empty in production behind 80/443)
TENANCY_URL_PORT=8000

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=school_saas
DB_USERNAME=root
DB_PASSWORD=
DB_TIMEZONE=+06:00

# Keep SESSION_DOMAIN empty: host-only cookies isolate branch sessions.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=school_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@schooldomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Initial platform Super Admin (used by `php artisan db:seed` / school:create-super-admin)
SEED_SUPER_ADMIN_EMAIL=superadmin@schooldomain.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMe!2026
# Number of demo branches created by the demo seeder (local/staging only)
SEED_DEMO_BRANCHES=10

VITE_APP_NAME="${APP_NAME}"
SEED_DEMO_STUDENTS_PER_BRANCH=24

# --- Part 7: security, backups, monitoring ---
# Roles that must use two-factor authentication (comma separated role names), e.g. super-admin,institution-admin
SECURITY_2FA_REQUIRED_ROLES=
# Encrypts backup zips with AES-256 — keep this value somewhere other than the server too!
BACKUP_PASSPHRASE=
BACKUP_KEEP_DAYS=30
# Uptime monitor: GET /health/status?token=<HEALTH_TOKEN> (404 until set) and an e-mail address for failure alerts
HEALTH_TOKEN=
MONITOR_ALERT_EMAIL=
# Log queries slower than this many milliseconds (0 = off; production default 500)
PERF_SLOW_QUERY_MS=
